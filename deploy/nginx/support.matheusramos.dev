# support.matheusramos.dev: the demo's old address. It now lives at
# https://matheusramos.dev/projects/support/ (support-location.conf in the main vhost), and this
# vhost only answers 301 there, keeping the path so old links to /docs and the like still land.
# Installed as /etc/nginx/sites-available/support.matheusramos.dev (see docs/deploy.md). The DNS
# record and the Origin Certificate stay: the redirect needs TLS on this name.

server {
    listen 80;
    listen [::]:80;
    server_name support.matheusramos.dev;
    return 301 https://matheusramos.dev/projects/support$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name support.matheusramos.dev;

    # Cloudflare Origin Certificate (Cloudflare SSL mode: Full (strict)).
    ssl_certificate /etc/nginx/ssl/support.matheusramos.dev.pem;
    ssl_certificate_key /etc/nginx/ssl/support.matheusramos.dev.key;

    return 301 https://matheusramos.dev/projects/support$request_uri;
}
