# Copy to .env and fill in. Never commit .env. Placeholders only in this file.
# Compose sets DATABASE_URL, REDIS_URL and LOGISTICS_URL from the values below.

# Postgres (the volume is initialized with this password: don't change it afterwards)
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# JWT_TTL_SECONDS=3600
# Mints a token for any seeded identity: local development and eval only, never in production.
# DEV_TOKEN_ENABLED=false

# Public demo (Cloudflare Turnstile; Demo Visitors chat after the check)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# DEMO_TOKEN_TTL_SECONDS=7200
# Prefix nginx strips before proxying (e.g. /projects/support), for the API docs.
# ROOT_PATH=

# LLM provider: anthropic, or openai_compatible (e.g. a self-hosted OpenAI-compatible router; see docs/development.md → LLM provider)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5
RESPONDER_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT_SECONDS=180

# Abuse protection (per IP limits are in the nginx vhost)
# CONVERSATION_TURNS_PER_WINDOW=10
# CONVERSATION_RATE_WINDOW_SECONDS=60
# Across all Customers, UTC days. 300 under Compose (production), 2000 outside it.
# LLM_CALLS_PER_DAY=300
# IDEMPOTENCY_TTL_SECONDS=86400
# IDEMPOTENCY_IN_FLIGHT_TTL_SECONDS=900

# Working State cache (Redis)
# WORKING_STATE_TTL_SECONDS=1800

# LangSmith tracing: forced off under Compose (production); see docs/development.md → Tracing.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=support-agent

# Agent tuning (defaults shown; rarely changed)
# WORKING_STATE_WINDOW=20
# LOGISTICS_TIMEOUT_SECONDS=3.0
# TOOL_RETRIES=2
# TOOL_RETRY_BACKOFF_SECONDS=0.5
# TOOL_FAILURES_BEFORE_ESCALATION=2
# CLARIFICATION_CONFIDENCE=0.7
# CLARIFICATIONS_BEFORE_ESCALATION=2
# RECENT_ORDER_DAYS=30
# RECENT_ORDERS_LIMIT=5
# KNOWLEDGE_TOP_K=3
# KNOWLEDGE_MIN_SCORE=0.45
# REFUND_DELIVERY_WINDOW_DAYS=30
# REFUND_LATE_AFTER_DAYS=10

# Not here: EMBEDDING_MODEL is baked into the image (change it in config.py).
